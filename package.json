{
    "name": "windev-react-monorepo",
    "private": true,
    "version": "0.0.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "pnpm --filter @app/web dev",
        "dev:api": "pnpm --filter @app/api dev",
        "build": "pnpm --filter @app/web build && pnpm --filter @app/api build",
        "lint": "echo \"Add lint scripts per package\"",
        "start": "node ./packages/server-start-placeholder.js"
    }
}